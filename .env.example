# Required to send contact requests. Never expose these variables to the browser.
BREVO_API_KEY=
# Sender address on a domain authenticated in that Brevo account.
# Example: Blue <marketing@aisolutionsblue.com>
CONTACT_FROM=
# Public canonical origin; change only for a separate staging environment.
SITE_ORIGIN=https://aisolutionsblue.com

# Contacts portal (/admin). Supabase project URL and its secret key (server only).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Team password for /admin, at least 12 characters. Changing it signs everyone out.
ADMIN_PASSWORD=

# Meta instant-form leads webhook (/api/meta-leads).
# App Secret of the Meta app, a Page token with leads_retrieval, and a verify token you choose.
META_APP_SECRET=
META_PAGE_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Funnel of the portal (/admin/embudo): Google Analytics Data API, read-only.
# On Vercel nothing is needed: the deployment's OIDC token is exchanged (Workload Identity
# Federation, pool «vercel» of Google Cloud project blue-portal-embudo) for a token of the service
# account portal-embudo@blue-portal-embudo.iam.gserviceaccount.com, Viewer of the GA4 property.
# Locally, a JSON key of a service account with Viewer access can be used instead:
GA4_SERVICE_ACCOUNT=
# Optional: GA4 property id (defaults to Blue's, 561100015).
GA4_PROPERTY_ID=

# Inversión del portal (/admin/inversion): gasto de Meta leído solo (Marketing API, solo lectura).
# Token del usuario del sistema «Portal contactos» con el permiso ads_read y la cuenta publicitaria
# asignada. Se firma con META_APP_SECRET.
META_ADS_TOKEN=
# Opcional: cuenta publicitaria (por defecto la de Blue, 1106106519033512).
META_AD_ACCOUNT_ID=
