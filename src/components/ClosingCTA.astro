---
import Icon from './Icon.astro';
---

<section class="closing-cta" id="contacto" aria-labelledby="closing-title">
  <div class="closing-glow" aria-hidden="true"></div>
  <div class="shell closing-content">
    <h2 id="closing-title">
      Tu negocio puede llegar más lejos.
      <br />
      <span>Hagámoslo posible.</span>
    </h2>
    <p>Conectemos la inteligencia artificial con lo que tu negocio necesita para crecer.</p>
    <a class="button button-blue" href="/contacto">
      Contactarnos <Icon name="diagonal" size={20} />
    </a>
  </div>
</section>

<style>
  .closing-cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(76px, 9vw, 136px) 0;
    background: #f2f7ff;
    border-top: 1px solid #e0e9f6;
    text-align: center;
  }
  .closing-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 50% 110%, #cfddff 0%, transparent 65%),
      radial-gradient(ellipse at 85% 10%, #e3f5ff 0%, transparent 55%);
  }
  .closing-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h2 {
    max-width: 960px;
    font-size: clamp(36px, 4.7vw, 64px);
    line-height: 1.16;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  h2 span {
    color: var(--blue);
  }
  p {
    max-width: 520px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
    text-wrap: balance;
  }
  .button {
    margin-top: 32px;
    gap: 30px;
  }
  @media (max-width: 700px) {
    p {
      font-size: 16px;
    }
    h2 {
      font-size: clamp(34px, 8vw, 46px);
    }
  }
</style>
