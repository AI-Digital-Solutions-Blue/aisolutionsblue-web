---
// Orbits: the ring of the logo at a large scale, as thin concentric circles at the edge of a
// section, with small rings travelling slowly around them. Purely decorative.
interface Props {
  /** Where the orbits sit inside their (relative, clipped) section. */
  at?: 'top-right' | 'bottom-right' | 'left';
  /** 'dark' for ink backgrounds. */
  tone?: 'light' | 'dark';
}
const { at = 'top-right', tone = 'light' } = Astro.props;
---

<div class:list={['orbits', `orbits-${at}`, `orbits-${tone}`]} aria-hidden="true">
  <span class="orbit orbit-1"><i></i></span>
  <span class="orbit orbit-2"><i></i></span>
  <span class="orbit orbit-3"></span>
</div>

<style>
  .orbits {
    position: absolute;
    z-index: 0;
    width: clamp(420px, 52vw, 820px);
    aspect-ratio: 1;
    pointer-events: none;
    --line: #2f5bff24;
    --dot: var(--blue);
    --dot-fill: #fff;
  }
  .orbits-dark {
    --line: #ffffff1c;
    --dot: #8fb0ff;
    --dot-fill: var(--ink);
  }
  .orbits-top-right {
    top: 0;
    right: 0;
    transform: translate(38%, -42%);
  }
  .orbits-bottom-right {
    right: 0;
    bottom: 0;
    transform: translate(34%, 40%);
  }
  .orbits-left {
    left: 0;
    top: 50%;
    transform: translate(-58%, -50%);
  }
  .orbit {
    position: absolute;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .orbit-1 {
    inset: 0;
    animation: orbit-spin 70s linear infinite;
  }
  .orbit-2 {
    inset: 16%;
    animation: orbit-spin 48s linear infinite reverse;
  }
  .orbit-3 {
    inset: 32%;
  }
  /* A small ring of the logo travelling on the orbit. */
  .orbit i {
    position: absolute;
    left: 50%;
    top: 0;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border: 2.5px solid var(--dot);
    border-radius: 50%;
    background: var(--dot-fill);
  }
  .orbit-2 i {
    top: auto;
    bottom: 0;
    margin: 0 0 -6px -6px;
  }
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  /* On phones the orbits stay a quiet accent in the corner, never a block of empty space. */
  @media (max-width: 640px) {
    .orbits {
      width: 260px;
      opacity: 0.7;
    }
    .orbits-top-right {
      transform: translate(48%, -52%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit {
      animation: none;
    }
  }
</style>
