---
import Icon from './Icon.astro';
import { company } from '../data/site';
import { CONTACT_INTERESTS } from '../lib/contact';
interface Props {
  /** h1 on /contacto, h2 when the form closes the home page. */
  heading?: 'h1' | 'h2';
  id?: string;
  /** Section heading; the home page closes with its own line. */
  title?: string;
}
const {
  heading = 'h1',
  id = 'contacto',
  title = 'Contáctanos.',
} = Astro.props;
const Heading = heading;
---

<section class="contact-section section-space" id={id} aria-labelledby="contact-title">
  <div class="shell contact-layout">
    <div class="contact-copy">
      <Heading id="contact-title">{title}</Heading>
      <p>
        Cuéntanos cómo es tu negocio y vemos juntos qué te frena y qué tecnología te ayudaría a
        crecer.
      </p>
      <ul class="contact-promises">
        <li>Sin compromiso.</li>
        <li>Sin tecnicismos: hablamos de tu negocio.</li>
        <li>Te respondemos lo antes posible.</li>
      </ul>
    </div>
    <form
      class="contact-form"
      action="/api/contact"
      method="POST"
      aria-labelledby="contact-title"
      data-contact-form
    >
      <p class="form-title">Cuéntanos un poco de tu empresa.</p>
      <div class="form-grid">
        <div class="form-field">
          <label for="name">
            Tu nombre <span aria-hidden="true">*</span>
          </label>
          <input
            id="name"
            name="name"
            autocomplete="name"
            placeholder="Nombre y apellidos"
            required
            minlength="2"
            maxlength="100"
          />
        </div>
        <div class="form-field">
          <label for="email">
            Email <span aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="tu@negocio.com"
            required
            maxlength="254"
          />
        </div>
        <div class="form-field">
          <label for="phone">
            Teléfono <span class="optional">(opcional)</span>
          </label>
          <input
            id="phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="Tu teléfono de contacto"
            maxlength="30"
          />
        </div>
        <div class="form-field">
          <label for="interest">
            ¿En qué podemos ayudarte? <span aria-hidden="true">*</span>
          </label>
          <select id="interest" name="interest" required>
            <option value="" disabled selected>
              Selecciona una opción
            </option>
            {CONTACT_INTERESTS.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="form-field">
        <label for="message">
          ¿Qué tarea te quita más tiempo? <span aria-hidden="true">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          minlength="10"
          maxlength="3000"
          placeholder="Por ejemplo: contestamos muchas llamadas para dar citas y se nos escapan clientes."
        ></textarea>
      </div>
      <div class="form-trap" aria-hidden="true">
        <label for="website">Deja este campo vacío</label>
        <input id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <label class="consent-label">
        <input type="checkbox" name="consent" required value="yes" />
        <span>
          He leído y acepto la{' '}
          <a href="/privacy-policy" target="_blank" rel="noopener">
            política de privacidad<span class="sr-only"> (nueva pestaña)</span>
          </a>{' '}
          y los{' '}
          <a href="/terms-and-conditions" target="_blank" rel="noopener">
            términos y condiciones<span class="sr-only"> (nueva pestaña)</span>
          </a>
          .
        </span>
      </label>
      <button type="submit" class="button button-blue form-submit">
        <span data-submit-label>Enviar</span>
        <Icon name="diagonal" size={20} />
      </button>
      <p class="form-note">
        Los campos con * son obligatorios. Usaremos tus datos para atender tu consulta.
      </p>
      <div class="form-status" tabindex="-1" role="status" aria-live="polite" hidden></div>
    </form>
    <div class="direct-contact">
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <span>Desde Las Palmas de Gran Canaria.</span>
    </div>
  </div>
</section>
