---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---

<section class="qa" id="preguntas" aria-labelledby="faq-title">
  <div class="shell qa-layout">
    <h2 id="faq-title" data-reveal>Lo que suelen preguntarnos.</h2>
    <div class="qa-list">
      {faqs.map((item) => (
        <details>
          <summary>
            {item.question}
            <Icon name="plus" size={20} />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
