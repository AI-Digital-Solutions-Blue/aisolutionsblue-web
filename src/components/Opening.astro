---
// Opening of the home page: the reel fills the first screen, then the headline and the call to action.
import Icon from './Icon.astro';
import Reel from './Reel.astro';
import '../styles/opening.css';
interface Props {
  /** 'dark' sets the opening on deep night blue with real light; 'light' keeps it on white. */
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
---

<section class="opening" data-tone={tone} aria-labelledby="opening-title">
  <!-- Ambient light: a slow blue aurora behind the opening, purely decorative. -->
  <div class="aurora" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <Reel />
  <div class="shell opening-hero">
    <div class="opening-text">
      <h1 id="opening-title" class="opening-title">
        <span class="line">
          <span class="line-inner">Tecnología que</span>
        </span>
        <span class="line">
          <span class="line-inner">hace crecer</span>
        </span>
        <!-- prettier-ignore -->
        <span class="line"><span class="line-inner">tu negocio<span class="full-stop" data-full-stop><span class="sr-only">.</span></span></span></span>
      </h1>

      <div class="opening-lead">
        <p>
          Diseñamos, programamos y automatizamos lo que tu negocio necesita para crecer. Rápido y
          sin complicaciones.
        </p>
        <div class="opening-actions">
          <a class="button button-blue" href="/contacto">
            Contáctanos <Icon name="diagonal" size={19} />
          </a>
          <a class="text-link" href="#productos">
            Ver productos <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/opening';
</script>
