---
// Landing of the Google Ads search campaign «Software a medida» (PIEZA-011). Same message as the
// ads: Blue studies how the company works and builds its own software. Same visual language as
// the home page (dark stage, line reveals, looping scenes, scroll-filled process), plus its own
// scenes: loose tools assembling into one piece of software, and disorder put in order on scroll.
// The contact form is the shared one, so it fires the same conversions as /contacto.
// Copy rules: no prices, nothing «free», no invented figures, «IA» at most once, no sectors.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import Orbits from '../components/Orbits.astro';
import '../styles/home.css';
import '../styles/software-medida.css';

export const prerender = true;

/** Loose tools around the software in the hero; each flies into the module it becomes. */
const chips = [
  { label: 'pedidos_v3_final.xlsx', kind: 'sheet', module: 1 },
  { label: 'Pedido por WhatsApp', kind: 'chat', module: 0 },
  { label: 'Correo: ¿me pasas el Excel?', kind: 'mail', module: 3 },
  { label: 'Nota: llamar mañana', kind: 'note', module: 2 },
];
const modules = [
  {
    label: 'Clientes',
    icon: 'M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1M9.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z',
  },
  { label: 'Pedidos', icon: 'M4 7h16l-1.5 11h-13ZM8 7V5a4 4 0 0 1 8 0v2' },
  { label: 'Equipo', icon: 'M5 4h14v16H5zM9 9h6M9 13h6M9 17h3' },
  { label: 'Informes', icon: 'M4 20V10M10 20V4M16 20v-7M21 20H3' },
];

/** Today's scraps (the problem), scattered; the scroll puts them in order. */
const scraps = [
  { kind: 'sheet', title: 'clientes_2024.xlsx', line: 'Última versión (creo)' },
  { kind: 'chat', title: 'Pedido por WhatsApp', line: '¿Me lo apuntas tú?' },
  { kind: 'note', title: 'Nota pegada', line: 'Revisar factura de ayer' },
  { kind: 'mail', title: 'Correo reenviado', line: 'Te paso los datos otra vez' },
  { kind: 'sheet', title: 'presupuestos_final2.xlsx', line: 'Copiado a mano' },
  { kind: 'app', title: 'Otra aplicación', line: 'Contraseña en un papel' },
];
/** What each scrap becomes once it lives in the software. */
const ordered = ['Clientes', 'Pedidos', 'Tareas', 'Mensajes', 'Presupuestos', 'Informes'];

const pains = [
  'Hojas de cálculo sueltas que solo entiende quien las hizo.',
  'Saltar entre aplicaciones que no se hablan entre sí.',
  'Datos copiados a mano, dos y tres veces.',
];

const steps = [
  {
    title: 'Escuchar',
    text: 'Nos cuentas cómo es tu empresa, qué te frena y hacia dónde quieres crecer.',
    icon: 'M6 9a5 5 0 0 1 5-5h10a5 5 0 0 1 5 5v6a5 5 0 0 1-5 5h-6l-5 4v-4a5 5 0 0 1-4-5zM11 12h10M11 16h6',
  },
  {
    title: 'Estudiar el proceso',
    text: 'Analizamos cómo trabaja tu equipo hoy, paso a paso, antes de proponer nada.',
    icon: 'M14 5a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM21 21l6 6M10 14h8M10 18h5',
  },
  {
    title: 'Diseñar',
    text: 'Te proponemos una solución a tu medida y la ajustamos contigo antes de programarla.',
    icon: 'M5 7h22v18H5zM5 12h22M10 17h7M10 21h12M22 16l3 3-3 3',
  },
  {
    title: 'Construir',
    text: 'Desarrollamos tu software y lo probamos con tu forma real de trabajar.',
    icon: 'M6 10l10-5 10 5-10 5zM6 16l10 5 10-5M6 22l10 5 10-5',
  },
  {
    title: 'Acompañar',
    text: 'Lo ponemos en marcha contigo y con tu equipo, para que se use desde el primer día.',
    icon: 'M16 4c5 3 7 8 6 14l-6 4-6-4c-1-6 1-11 6-14zM16 13a2 2 0 1 0 0 .1M10 18l-4 4 5 1M22 18l4 4-5 1M14 26l2 3 2-3',
  },
];
---

<Layout
  title="Software a medida para tu empresa · Blue"
  description="Desarrollamos software a medida para empresas: software de gestión, aplicaciones, automatización de procesos, integración de herramientas y CRM o ERP a medida. Primero estudiamos cómo trabajas."
>
  <Header />
  <main id="main" class="smx">
    <!-- 1. Stage: loose tools fly into one piece of software. -->
    <section class="smx-hero" aria-labelledby="smx-title">
      <div class="smx-stage">
        <span class="smx-gridlines" aria-hidden="true"></span>
        <span class="smx-glow" aria-hidden="true"></span>
        <Orbits at="top-right" tone="dark" />
        <div class="shell smx-hero-layout">
          <div class="smx-hero-copy">
            <p class="smx-pill">
              <span aria-hidden="true"></span>Software a medida
            </p>
            <h1 id="smx-title" data-hero-title>
              Software <span class="smx-gradient">a medida</span> para tu empresa.
            </h1>
            <p class="smx-promise" data-hero-fade>
              Primero estudiamos cómo trabaja tu empresa. Después construimos tu software.{' '}
              <b>Solo tuyo, a tu medida.</b>
            </p>
            <div class="smx-actions" data-hero-fade>
              <a class="button button-blue" href="#contacto">
                Cuéntanos cómo trabajas <Icon name="arrow" size={18} />
              </a>
              <a class="smx-light-link" href="#caso">
                Ver un caso real <Icon name="arrow" size={16} />
              </a>
            </div>
          </div>

          <div class="smx-assembly" data-assembly aria-hidden="true">
            <div class="smx-window" data-window>
              <div class="smx-window-bar">
                <i></i>
                <i></i>
                <i></i>
                <span>Tu empresa</span>
              </div>
              <div class="smx-window-body">
                <div class="smx-side">
                  <span class="smx-side-logo"></span>
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
                <div class="smx-main">
                  <div class="smx-modules">
                    {modules.map((module) => (
                      <div class="smx-module" data-module>
                        <svg viewBox="0 0 24 24">
                          <path d={module.icon} />
                        </svg>
                        <b>{module.label}</b>
                        <span class="smx-module-bar" />
                      </div>
                    ))}
                  </div>
                  <div class="smx-chart">
                    <svg viewBox="0 0 220 70" preserveAspectRatio="none">
                      <path
                        class="smx-chart-area"
                        d="M0 62 C30 58 46 50 70 46 S110 30 134 28 S180 14 220 8 V70 H0 Z"
                      ></path>
                      <path
                        data-chart
                        d="M0 62 C30 58 46 50 70 46 S110 30 134 28 S180 14 220 8"
                      ></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
            {chips.map((chip, i) => (
              <span
                class={`smx-chip smx-chip-${i} is-${chip.kind}`}
                data-chip
                data-target={chip.module}
              >
                <i />
                {chip.label}
              </span>
            ))}
            <span class="smx-done" data-done>
              <Icon name="check" size={16} /> Todo en un solo lugar
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. The problem: today's scraps, put in order by the scroll. -->
    <section class="smx-chaos" data-chaos aria-labelledby="smx-problem-title">
      <div class="shell smx-chaos-layout">
        <div class="smx-chaos-copy">
          <p class="section-eyebrow">El problema</p>
          <h2 id="smx-problem-title" data-reveal>
            Tu empresa creció. Tus herramientas, no.
          </h2>
          <p class="smx-lead">
            Lo que funcionaba cuando erais pocos hoy se queda corto. El día a día se reparte entre
            archivos, aplicaciones y la memoria de alguien del equipo.
          </p>
          <ul class="smx-pains">
            {pains.map((pain) => (
              <li data-pain>
                <span aria-hidden="true">
                  <Icon name="close" size={14} />
                </span>
                {pain}
              </li>
            ))}
          </ul>
        </div>
        <div class="smx-board" data-board aria-hidden="true">
          <p class="smx-board-label">
            <span data-label-before>Así trabaja hoy tu empresa</span>
            <span data-label-after>Así puede trabajar: todo en un solo lugar</span>
          </p>
          <div class="smx-frame" data-frame>
            <div class="smx-frame-bar">
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div class="smx-slots">
              {ordered.map(() => (
                <span class="smx-slot" data-slot />
              ))}
            </div>
          </div>
          {scraps.map((scrap, i) => (
            <div class={`smx-scrap smx-scrap-${i} is-${scrap.kind}`} data-scrap>
              <div class="smx-scrap-mess">
                <b>{scrap.title}</b>
                <small>{scrap.line}</small>
              </div>
              <div class="smx-scrap-order">
                <Icon name="check" size={14} />
                <b>{ordered[i]}</b>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. What Blue builds: one looping scene per line of work, like the home page. -->
    <section class="services smx-builds" aria-labelledby="smx-builds-title">
      <Orbits at="top-right" />
      <div class="shell">
        <div class="section-intro">
          <div>
            <p class="section-eyebrow">Qué construimos</p>
            <h2 id="smx-builds-title" data-reveal>
              El software que tu empresa necesita, hecho para ella.
            </h2>
          </div>
          <p>
            Diseñamos tu software, automatizamos tus procesos y creamos las herramientas que tu
            empresa necesita. Para que trabaje mejor y crezca.
          </p>
        </div>
        <ol class="svc-list smx-svc-list">
          <li class="svc">
            <div class="svc-text">
              <h3>Software de gestión a medida</h3>
              <p>
                Todo tu negocio en un solo lugar: clientes, pedidos, equipo y procesos, organizados
                como trabaja tu empresa.
              </p>
            </div>
            <div class="vis" data-vis="software" aria-hidden="true">
              <div class="vis-dash">
                <div class="vis-side">
                  <span class="vis-logo"></span>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
                <div class="vis-main">
                  <div class="vis-tiles">
                    <div class="vis-tile">
                      <small>Pedidos</small>
                      <svg viewBox="0 0 120 40">
                        <path
                          data-spark
                          d="M2 34 C20 30 30 32 44 24 S70 18 82 14 S104 8 118 4"
                        ></path>
                      </svg>
                    </div>
                    <div class="vis-tile">
                      <small>Clientes</small>
                      <svg viewBox="0 0 120 40">
                        <path
                          data-spark
                          d="M2 36 C18 34 34 28 50 26 S80 16 92 12 S110 6 118 6"
                        ></path>
                      </svg>
                    </div>
                  </div>
                  <div class="vis-bars">
                    {[0.45, 0.6, 0.5, 0.72, 0.66, 0.85, 0.95].map((h) => (
                      <span style={`--h:${h}`} data-bar />
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </li>

          <li class="svc">
            <div class="svc-text">
              <h3>Aplicaciones para empresas</h3>
              <p>
                Web, móvil o de gestión interna. Una aplicación hecha para tu equipo o para tus
                clientes, no un programa genérico.
              </p>
            </div>
            <div class="vis" data-vis="apps" aria-hidden="true">
              <div class="smx-apps">
                <div class="smx-apps-web">
                  <div class="smx-apps-bar">
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                  {[0, 1, 2, 3].map(() => (
                    <div class="smx-apps-row" data-app-row>
                      <span />
                      <b />
                      <em />
                    </div>
                  ))}
                </div>
                <div class="smx-apps-phone">
                  <span class="smx-apps-notch"></span>
                  {[0, 1, 2].map(() => (
                    <div class="smx-apps-card" data-app-card>
                      <span />
                      <b />
                    </div>
                  ))}
                  <span class="smx-apps-cta" data-app-cta>
                    Hecho
                  </span>
                </div>
                <div class="smx-apps-tabs">
                  <span data-app-tab>Web</span>
                  <span data-app-tab>Móvil</span>
                  <span data-app-tab>Gestión interna</span>
                </div>
              </div>
            </div>
          </li>

          <li class="svc">
            <div class="svc-text">
              <h3>Automatización de procesos e integración de herramientas</h3>
              <p>
                Automatizamos las tareas que hoy se hacen a mano y conectamos las herramientas que
                ya usas, para que los datos pasen solos de una a otra. Y, donde aporta, la IA
                trabaja dentro de tu software.
              </p>
            </div>
            <div class="vis" data-vis="automatizacion" aria-hidden="true">
              <div class="vis-flow">
                <span class="vis-track">
                  <span class="vis-track-fill" data-fill></span>
                </span>
                <span class="vis-runner" data-runner></span>
                {['Nuevo pedido', 'Factura creada', 'Cliente avisado'].map((label) => (
                  <div class="vis-node" data-node>
                    <span class="vis-node-dot" />
                    <b>{label}</b>
                  </div>
                ))}
                <span class="vis-auto" data-auto>
                  Sin tocar nada
                </span>
              </div>
            </div>
          </li>

          <li class="svc">
            <div class="svc-text">
              <h3>CRM y ERP a medida</h3>
              <p>
                Un CRM o un ERP pensado para tu forma de vender y de operar, sin pantallas ni pasos
                que tu equipo no necesita.
              </p>
            </div>
            <div class="vis" data-vis="crm" aria-hidden="true">
              <div class="smx-crm">
                {['Contacto', 'Propuesta', 'Cliente'].map((column) => (
                  <div class="smx-crm-col" data-crm-col>
                    <small>{column}</small>
                  </div>
                ))}
                <div class="smx-crm-card" data-crm-card>
                  <span></span>
                  <b></b>
                  <em></em>
                </div>
              </div>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- 4. How we work: the home page's process line, with the five steps of a project. -->
    <section class="process smx-process" id="como-trabajamos" aria-labelledby="smx-steps-title">
      <Orbits at="bottom-right" />
      <div class="shell">
        <div class="section-intro">
          <div>
            <p class="section-eyebrow">Cómo trabajamos</p>
            <h2 id="smx-steps-title" data-reveal>
              Primero te escuchamos. Después construimos.
            </h2>
          </div>
          <p>Un software a medida empieza por entender tu negocio, no por programar.</p>
        </div>
        <div class="process-track" data-process>
          <span class="process-line" aria-hidden="true">
            <span data-process-fill></span>
          </span>
          <ol class="process-steps">
            {steps.map((step, i) => (
              <li class="process-step">
                <span class="process-index" aria-hidden="true">
                  {i + 1}
                </span>
                <svg class="process-icon" viewBox="0 0 32 32" aria-hidden="true">
                  <path d={step.icon} pathLength="1" />
                </svg>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 5. Proof: Siweb, a platform built to measure. -->
    <section class="smx-case" id="caso" aria-labelledby="smx-case-title">
      <div class="shell smx-case-layout">
        <div class="smx-case-copy">
          <p class="section-eyebrow">Un caso real</p>
          <h2 id="smx-case-title" data-reveal>
            Siweb, una plataforma hecha a medida.
          </h2>
          <p class="smx-lead">
            Siweb reúne en un solo lugar las llamadas, los contactos, las campañas y las
            estadísticas de un equipo. Es software a medida: pensado para su forma de trabajar.
          </p>
          <ul class="smx-case-tags">
            <li>Llamadas</li>
            <li>Contactos</li>
            <li>Campañas</li>
            <li>Estadísticas</li>
          </ul>
          <a class="text-link" href="/productos/siweb">
            Ver el caso de Siweb <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="smx-case-visual" data-case>
          <figure class="smx-case-shot" data-case-shot>
            <img
              src="/assets/siweb/siweb.2.webp"
              alt="Plataforma Siweb con llamadas programadas y la ficha de un contacto"
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <Contact
      heading="h2"
      title="Cuéntanos cómo trabajas."
      intro="Cuéntanos cómo trabaja tu empresa y qué te gustaría mejorar. Te respondemos para ver juntos qué software necesita."
      placeholder="Por ejemplo: llevamos los pedidos en hojas de cálculo y queremos tenerlo todo en un solo lugar."
    />
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/home';
  import '../scripts/softwareMedida';
</script>
