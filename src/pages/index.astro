---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Opening from '../components/Opening.astro';
import Services from '../components/Services.astro';
import Products from '../components/Products.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import '../styles/home.css';
---

<Layout
  title="Blue · Tecnología que hace crecer tu negocio"
  description="Diseñamos, programamos y automatizamos lo que tu negocio necesita para crecer: atención a cualquier hora, reservas en orden, clientes nuevos y menos gestión. Rápido y sin complicaciones."
>
  <Header home />
  <main id="main">
    <!-- tone="dark" sets the opening on night blue; the white opening was chosen on 7 Oct 2026. -->
    <Opening tone="light" />
    <Services />
    <Products />
    <Process />
    <About />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/home';
</script>
