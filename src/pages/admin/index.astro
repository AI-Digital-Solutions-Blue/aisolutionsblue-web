---
// Private contacts portal: every contact from the web form and from Meta's instant form.
// Not linked anywhere and not indexed; protected by the team password.
import { describeAttribution } from '../../lib/attribution';
import { adminPassword, isAdmin, NO_INDEX } from '../../lib/admin-auth';
import {
  CONTACT_STATUSES,
  isSource,
  isStatus,
  listContacts,
  SOURCE_LABELS,
  STATUS_LABELS,
  storeConfig,
  type StoredContact,
} from '../../lib/contacts-store';

export const prerender = false;
for (const [name, value] of Object.entries(NO_INDEX)) Astro.response.headers.set(name, value);

const signedIn = isAdmin(Astro.cookies);
const errors: Record<string, string> = {
  password: 'La contraseña no es correcta.',
  wait: 'Demasiados intentos. Espera unos minutos.',
  off: 'El portal no tiene contraseña configurada todavía.',
  save: 'No se ha podido guardar el cambio. Inténtalo de nuevo.',
};
const error = errors[Astro.url.searchParams.get('error') || ''] || '';
const metaState = Astro.url.searchParams.get('meta') || '';
const metaDetail = (Astro.url.searchParams.get('detalle') || '').slice(0, 200);
const metaNotice =
  metaState === 'ok'
    ? metaDetail || 'Página conectada.'
    : metaState === 'off'
      ? 'Faltan las claves de Meta en Vercel.'
      : metaState === 'error'
        ? `Meta respondió: ${metaDetail}`
        : '';
const sourceParam = Astro.url.searchParams.get('origen') || '';
const statusParam = Astro.url.searchParams.get('estado') || '';
const filter = {
  ...(isSource(sourceParam) ? { source: sourceParam } : {}),
  ...(isStatus(statusParam) ? { status: statusParam } : {}),
};
const back = Astro.url.search;

const store = storeConfig();
let contacts: StoredContact[] = [];
let loadError = '';
if (signedIn) {
  if (!store) loadError = 'Falta conectar la base de datos (SUPABASE_URL y SUPABASE_SECRET_KEY).';
  else
    try {
      contacts = await listContacts(store, filter);
    } catch {
      loadError = 'No se han podido cargar los contactos. Recarga la página en un momento.';
    }
}

const when = new Intl.DateTimeFormat('es-ES', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'Atlantic/Canary',
});
const origin = (contact: StoredContact) => {
  if (contact.source === 'meta_form') {
    const m = contact.meta || {};
    return [
      m.campaign_name && `Campaña: ${m.campaign_name}`,
      m.adset_name && `Conjunto: ${m.adset_name}`,
      m.ad_name && `Anuncio: ${m.ad_name}`,
      m.form_id && `Formulario: ${m.form_id}`,
      m.platform && `Plataforma: ${m.platform}`,
    ].filter(Boolean) as string[];
  }
  const lines = describeAttribution(contact.attribution || {});
  return lines.length ? lines : ['Visita directa'];
};
const link = (params: Record<string, string>) => {
  const query = new URLSearchParams(params).toString();
  return query ? `/admin?${query}` : '/admin';
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Contactos · Blue</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #0a1022;
        --muted: #5b6478;
        --line: #e3e6ee;
        --bg: #f6f7fb;
        --card: #fff;
        --blue: #2f5bff;
        --meta: #0866ff;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font:
          15px/1.5 system-ui,
          -apple-system,
          sans-serif;
        color: var(--ink);
        background: var(--bg);
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px 16px 64px;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
      }
      h1 {
        font-size: 24px;
        margin: 0;
      }
      .header-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }
      .notice {
        background: #effaf3;
        border: 1px solid #bfe8cd;
        color: #135c2e;
        padding: 10px 14px;
        border-radius: 10px;
        margin-bottom: 16px;
      }
      .muted {
        color: var(--muted);
      }
      .error {
        background: #fff1f0;
        border: 1px solid #ffc9c4;
        color: #9b1c12;
        padding: 10px 14px;
        border-radius: 10px;
        margin-bottom: 16px;
      }
      button,
      select,
      input,
      textarea {
        font: inherit;
      }
      button {
        border: 0;
        border-radius: 8px;
        padding: 8px 14px;
        background: var(--ink);
        color: #fff;
        cursor: pointer;
      }
      button.ghost {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--line);
      }
      .login {
        max-width: 360px;
        margin: 15vh auto;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 24px;
        display: grid;
        gap: 12px;
      }
      .login input {
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
      }
      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
      }
      .filters a {
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--card);
        color: var(--ink);
        text-decoration: none;
        font-size: 14px;
      }
      .filters a[aria-current] {
        background: var(--ink);
        color: #fff;
        border-color: var(--ink);
      }
      .contact {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 12px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 20px;
      }
      .contact h2 {
        font-size: 18px;
        margin: 0 0 4px;
      }
      .tag {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 999px;
        background: #eef2ff;
        color: var(--blue);
      }
      .tag.meta_form {
        background: #e7f0ff;
        color: var(--meta);
      }
      .tag.status {
        background: #f0f1f5;
        color: var(--muted);
      }
      .tag.status.nuevo {
        background: #fff4d6;
        color: #8a5a00;
      }
      .reach {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        margin: 8px 0;
      }
      .reach a {
        color: var(--blue);
      }
      .message {
        white-space: pre-wrap;
        margin: 8px 0;
      }
      .origin {
        font-size: 13px;
        color: var(--muted);
        margin: 8px 0 0;
        padding: 0;
        list-style: none;
      }
      .side form {
        display: grid;
        gap: 8px;
      }
      .side select,
      .side textarea {
        width: 100%;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
      }
      .empty {
        text-align: center;
        padding: 48px 16px;
        color: var(--muted);
      }
      @media (max-width: 760px) {
        .contact {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    {!signedIn ? (
      <form class="login" method="post" action="/api/admin/login">
        <h1>Contactos de Blue</h1>
        {error && <p class="error">{error}</p>}
        {!adminPassword() && !error && (
          <p class="muted">El portal no tiene contraseña configurada todavía.</p>
        )}
        <label for="password">Contraseña del equipo</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
        <button type="submit">Entrar</button>
      </form>
    ) : (
      <main>
        <header>
          <div>
            <h1>Contactos</h1>
            <span class="muted">
              {contacts.length} {contacts.length === 1 ? 'contacto' : 'contactos'}
            </span>
          </div>
          <div class="header-actions">
            <form method="post" action="/api/admin/meta-page">
              <button
                class="ghost"
                type="submit"
                title="Hace que los contactos del formulario de Meta lleguen a este portal"
              >
                Conectar página de Meta
              </button>
            </form>
            <form method="post" action="/api/admin/login">
              <input type="hidden" name="action" value="logout" />
              <button class="ghost" type="submit">
                Salir
              </button>
            </form>
          </div>
        </header>
        {metaNotice && <p class={metaState === 'ok' ? 'notice' : 'error'}>{metaNotice}</p>}
        {error && <p class="error">{error}</p>}
        {loadError && <p class="error">{loadError}</p>}
        <nav class="filters" aria-label="Origen">
          <a
            href={link({ ...(filter.status ? { estado: filter.status } : {}) })}
            aria-current={!filter.source ? 'page' : undefined}
          >
            Todos los orígenes
          </a>
          {(['web', 'meta_form'] as const).map((source) => (
            <a
              href={link({ origen: source, ...(filter.status ? { estado: filter.status } : {}) })}
              aria-current={filter.source === source ? 'page' : undefined}
            >
              {source === 'web' ? 'Web' : 'Meta'}
            </a>
          ))}
        </nav>
        <nav class="filters" aria-label="Estado">
          <a
            href={link({ ...(filter.source ? { origen: filter.source } : {}) })}
            aria-current={!filter.status ? 'page' : undefined}
          >
            Todos los estados
          </a>
          {CONTACT_STATUSES.map((status) => (
            <a
              href={link({ estado: status, ...(filter.source ? { origen: filter.source } : {}) })}
              aria-current={filter.status === status ? 'page' : undefined}
            >
              {STATUS_LABELS[status]}
            </a>
          ))}
        </nav>
        {!loadError && contacts.length === 0 && (
          <p class="empty">Todavía no hay contactos con estos filtros.</p>
        )}
        {contacts.map((contact) => (
          <article class="contact" id={`c-${contact.id}`}>
            <div>
              <span class={`tag ${contact.source}`}>{SOURCE_LABELS[contact.source]}</span>{' '}
              <span class={`tag status ${contact.status}`}>{STATUS_LABELS[contact.status]}</span>
              <h2>{contact.name}</h2>
              <span class="muted">{when.format(new Date(contact.created_at))}</span>
              <div class="reach">
                {contact.phone && (
                  <a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}>{contact.phone}</a>
                )}
                {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
              </div>
              {contact.interest && (
                <div>
                  <b>Necesita:</b> {contact.interest}
                </div>
              )}
              {contact.message && <p class="message">{contact.message}</p>}
              <ul class="origin">
                {origin(contact).map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
            <div class="side">
              <form method="post" action="/api/admin/contact">
                <input type="hidden" name="id" value={contact.id} />
                <input type="hidden" name="back" value={back} />
                <label class="muted" for={`s-${contact.id}`}>
                  Estado
                </label>
                <select id={`s-${contact.id}`} name="status">
                  {CONTACT_STATUSES.map((status) => (
                    <option value={status} selected={contact.status === status}>
                      {STATUS_LABELS[status]}
                    </option>
                  ))}
                </select>
                <label class="muted" for={`n-${contact.id}`}>
                  Notas
                </label>
                <textarea
                  id={`n-${contact.id}`}
                  name="notes"
                  rows="3"
                  maxlength="4000"
                  set:text={contact.notes || ''}
                ></textarea>
                <button type="submit">Guardar</button>
              </form>
            </div>
          </article>
        ))}
      </main>
    )}
  </body>
</html>
