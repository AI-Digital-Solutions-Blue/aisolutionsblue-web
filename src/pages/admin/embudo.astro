---
// Funnel of the private portal: what visitors do on the web (Google Analytics) and what happens to
// the contacts afterwards (the portal's statuses). Same password as the contacts page.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin, NO_INDEX } from '../../lib/admin-auth';
import { storeConfig } from '../../lib/contacts-store';
import { listSpend, summarizeSpend } from '../../lib/ad-spend';
import { ga4Config } from '../../lib/ga4';
import {
  CHANNEL_LABELS,
  CHANNELS,
  isChannel,
  isRange,
  loadFunnel,
  type Channel,
  type RangeDays,
  RANGES,
} from '../../lib/funnel';

export const prerender = false;
for (const [name, value] of Object.entries(NO_INDEX)) Astro.response.headers.set(name, value);
if (!isAdmin(Astro.cookies)) return Astro.redirect('/admin', 303);

const daysParam = Number(Astro.url.searchParams.get('dias') || 30);
const days: RangeDays = isRange(daysParam) ? daysParam : 30;
const channelParam = Astro.url.searchParams.get('canal') || '';
const channel: Channel | null = isChannel(channelParam) ? channelParam : null;
const data = await loadFunnel(days, channel, ga4Config(Astro.request.headers), storeConfig());
// Ad spend of the same days (lines whose period ends inside the range), for cost per contact.
const spendStore = storeConfig();
const spendSince = new Intl.DateTimeFormat('en-CA', { timeZone: 'Atlantic/Canary' }).format(
  new Date(Date.now() - (days - 1) * 24 * 60 * 60 * 1000),
);
const spend = spendStore
  ? await listSpend(spendStore, spendSince)
      .then(summarizeSpend)
      .catch(() => null)
  : null;
const spentBy: Partial<Record<Channel, number>> = spend
  ? { meta: spend.byPlatform.meta, google_ads: spend.byPlatform.google }
  : {};
const money = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
// Local preview only: sample visit numbers to review the layout without Google Analytics.
if (import.meta.env.DEV && Astro.url.searchParams.has('demo') && !data.web) {
  data.webError = '';
  data.web = {
    visitors: 1240,
    sessions: 1510,
    engagementRate: 0.58,
    avgEngagementSeconds: 74,
    pagesPerSession: 2.3,
    steps: [
      { key: 'visit', label: 'Visitan la web', people: 1240 },
      { key: 'view', label: 'Ven el formulario de contacto', people: 410 },
      { key: 'start', label: 'Empiezan a rellenarlo', people: 62 },
      { key: 'lead', label: 'Lo envían', people: 19 },
    ],
    pages: [
      { path: '/', views: 1620, avgSeconds: 58 },
      { path: '/contacto', views: 430, avgSeconds: 41 },
      { path: '/productos/adscena', views: 210, avgSeconds: 66 },
    ],
    devices: [
      { device: 'Móvil', people: 890 },
      { device: 'Ordenador', people: 330 },
      { device: 'Tableta', people: 20 },
    ],
    visitorsByChannel: { google_ads: 380, meta: 610, organico: 90, directo: 140, otros: 20 },
  };
}

const fmt = new Intl.NumberFormat('es-ES');
const pct = (part: number, whole: number) =>
  whole > 0
    ? `${new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 }).format((part / whole) * 100)} %`
    : '—';
const width = (part: number, whole: number) =>
  `--w:${whole > 0 ? Math.max(2, Math.min(100, (part / whole) * 100)) : 0}%`;
const duration = (seconds: number) => {
  const s = Math.round(seconds);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
};
const link = (params: { dias?: number; canal?: Channel | null }) => {
  const query = new URLSearchParams();
  const d = params.dias ?? days;
  const c = params.canal === undefined ? channel : params.canal;
  if (d !== 30) query.set('dias', String(d));
  if (c) query.set('canal', c);
  const text = query.toString();
  return text ? `/admin/embudo?${text}` : '/admin/embudo';
};
const SHORT: Record<Channel, string> = {
  google_ads: 'Google Ads',
  meta: 'Meta',
  organico: 'Orgánico',
  directo: 'Directo',
  otros: 'Otros',
};
const ICONS = {
  users:
    'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  visit: 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12ZM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  clock: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM12 6v6l4 2',
  pages: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm0 0v6h6M8 13h8M8 17h5',
  spark: 'm12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z',
};
const web = data.web;
const contacts = data.contacts;
const deviceTotal = web?.devices.reduce((sum, d) => sum + d.people, 0) || 0;
---

<AdminLayout
  title="Embudo"
  section="embudo"
  subtitle={`Últimos ${days} días · ${channel ? CHANNEL_LABELS[channel] : 'todos los canales'}`}
>
  <div class="toolbar">
    <nav class="segmented" aria-label="Periodo">
      {RANGES.map((d) => (
        <a href={link({ dias: d })} aria-current={d === days ? 'page' : undefined}>
          {d} días
        </a>
      ))}
    </nav>
    <nav class="segmented" aria-label="Canal">
      <a href={link({ canal: null })} aria-current={!channel ? 'page' : undefined}>
        Todos
      </a>
      {CHANNELS.map((c) => (
        <a href={link({ canal: c })} aria-current={c === channel ? 'page' : undefined}>
          {SHORT[c]}
        </a>
      ))}
    </nav>
  </div>

  {data.webError && <div class="alert alert-error">{data.webError}</div>}
  {data.contactsError && <div class="alert alert-error">{data.contactsError}</div>}

  {web && (
    <section class="kpis" aria-label="Resumen de visitas">
      {[
        { label: 'Visitantes', value: fmt.format(web.visitors), icon: ICONS.users },
        { label: 'Visitas', value: fmt.format(web.sessions), icon: ICONS.visit },
        {
          label: 'Atención media',
          value: duration(web.avgEngagementSeconds),
          icon: ICONS.clock,
          hint: 'Tiempo que cada visitante pasa mirando la web',
        },
        {
          label: 'Páginas por visita',
          value: web.pagesPerSession.toLocaleString('es-ES', { maximumFractionDigits: 1 }),
          icon: ICONS.pages,
        },
        {
          label: 'Visitas con interés',
          value: pct(web.engagementRate, 1),
          icon: ICONS.spark,
          hint: 'Más de 10 segundos, 2 páginas o un contacto',
        },
      ].map((kpi) => (
        <div class="card kpi" title={kpi.hint}>
          <span class="kpi-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path d={kpi.icon} />
            </svg>
          </span>
          <span class="kpi-label">{kpi.label}</span>
          <strong>{kpi.value}</strong>
        </div>
      ))}
    </section>
  )}

  <div class="grid">
    <section class="card panel">
      <div class="panel-head">
        <h2>En la web</h2>
        <p>Personas que dan cada paso. Solo cuenta a quien acepta las cookies de análisis.</p>
      </div>
      {web ? (
        <ol class="funnel">
          {web.steps.map((step, i) => (
            <li>
              <span class="step-n">{i + 1}</span>
              <div class="step-body">
                <div class="step-head">
                  <span>{step.label}</span>
                  <b>{fmt.format(step.people)}</b>
                </div>
                <div class="bar">
                  <i style={width(step.people, web.steps[0].people)} />
                </div>
                {i > 0 && (
                  <span class="rate">
                    {pct(step.people, web.steps[i - 1].people)} del paso anterior
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="muted">Sin datos de Google Analytics.</p>
      )}
    </section>

    <section class="card panel">
      <div class="panel-head">
        <h2>Después del contacto</h2>
        <p>Todos los contactos del periodo, según el estado que marcáis en el portal.</p>
      </div>
      {contacts ? (
        <>
          <ol class="funnel after">
            {contacts.steps.map((step, i) => (
              <li>
                <span class="step-n">{i + 1}</span>
                <div class="step-body">
                  <div class="step-head">
                    <span>{step.label}</span>
                    <b>{fmt.format(step.people)}</b>
                  </div>
                  <div class="bar">
                    <i style={width(step.people, contacts.steps[0].people)} />
                  </div>
                  {i > 0 && (
                    <span class="rate">
                      {pct(step.people, contacts.steps[i - 1].people)} del paso anterior
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ol>
          <div class="split">
            <span>
              Web <b>{fmt.format(contacts.web)}</b>
            </span>
            <span>
              Meta <b>{fmt.format(contacts.metaForm)}</b>
            </span>
            <span>
              Descartados <b>{fmt.format(contacts.discarded)}</b>
            </span>
          </div>
        </>
      ) : (
        <p class="muted">Sin datos de contactos.</p>
      )}
    </section>
  </div>

  <section class="card panel block">
    <div class="panel-head">
      <h2>Por canal</h2>
      <p>De dónde vienen las visitas, los contactos y los clientes.</p>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Canal</th>
            <th class="num">Visitantes</th>
            <th class="num">Contactos</th>
            <th class="num">Clientes</th>
            <th class="num">Contactos / 100 visitantes</th>
            <th class="num">Inversión</th>
            <th class="num">Coste por contacto</th>
          </tr>
        </thead>
        <tbody>
          {CHANNELS.map((c) => {
            const visitors = web?.visitorsByChannel[c] ?? 0;
            const row = contacts?.byChannel[c] ?? { contacts: 0, clients: 0 };
            return (
              <tr>
                <td>
                  <a class="channel" href={link({ canal: c })}>
                    <i class={`swatch ${c}`} />
                    {CHANNEL_LABELS[c]}
                  </a>
                </td>
                <td class="num">{web ? fmt.format(visitors) : '—'}</td>
                <td class="num">{fmt.format(row.contacts)}</td>
                <td class="num">{fmt.format(row.clients)}</td>
                <td class="num">
                  {web && visitors > 0
                    ? ((row.contacts / visitors) * 100).toLocaleString('es-ES', {
                        maximumFractionDigits: 1,
                      })
                    : '—'}
                </td>
                <td class="num">{spentBy[c] !== undefined ? money.format(spentBy[c]!) : '—'}</td>
                <td class="num">
                  {spentBy[c] !== undefined && row.contacts > 0
                    ? money.format(spentBy[c]! / row.contacts)
                    : '—'}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="note">
      Los visitantes solo incluyen a quien acepta cookies; los contactos son todos. Por eso los
      contactos por cada 100 visitantes son orientativos. La inversión sale de la pestaña Inversión.
    </p>
  </section>

  {web && (
    <div class="grid">
      <section class="card panel">
        <div class="panel-head">
          <h2>Páginas más vistas</h2>
          <p>Vistas y tiempo medio de atención en cada página.</p>
        </div>
        <ul class="pages">
          {web.pages.map((page) => (
            <li>
              <div class="page-row">
                <span class="path" title={page.path}>
                  {page.path}
                </span>
                <span class="tnum">
                  <b>{fmt.format(page.views)}</b>
                  <span class="muted"> · {duration(page.avgSeconds)}</span>
                </span>
              </div>
              <div class="bar thin">
                <i style={width(page.views, web.pages[0]?.views || 0)} />
              </div>
            </li>
          ))}
          {web.pages.length === 0 && <li class="muted">Todavía sin datos.</li>}
        </ul>
      </section>
      <section class="card panel">
        <div class="panel-head">
          <h2>Dispositivos</h2>
          <p>Desde dónde entran los visitantes.</p>
        </div>
        {deviceTotal > 0 ? (
          <>
            <div class="stack" role="img" aria-label="Reparto de visitantes por dispositivo">
              {web.devices.map((d, i) => (
                <i class={`seg s${i}`} style={width(d.people, deviceTotal)} />
              ))}
            </div>
            <ul class="legend">
              {web.devices.map((d, i) => (
                <li>
                  <i class={`seg s${i}`} />
                  <span>{d.device}</span>
                  <b class="tnum">{pct(d.people, deviceTotal)}</b>
                  <span class="muted tnum">{fmt.format(d.people)}</span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="muted">Todavía sin datos.</p>
        )}
      </section>
    </div>
  )}
  <p class="note foot">
    Los datos de Google Analytics pueden tardar unas horas en aparecer. Esta página se actualiza
    cada 10 minutos.
  </p>
</AdminLayout>

<style is:global>
  .kpis {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }
  .kpi {
    display: grid;
    gap: 2px;
    padding: 18px 18px 16px;
  }
  .kpi-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    margin-bottom: 10px;
    color: var(--blue);
    background: var(--blue-soft);
  }
  .kpi-icon svg,
  .channel svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .kpi-label {
    font-size: 13px;
    color: var(--muted);
  }
  .kpi strong {
    font: 700 28px/1.15 var(--display);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }
  .block {
    margin-bottom: 16px;
  }
  .funnel {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .funnel li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    font: 700 12px/1 var(--display);
    color: var(--blue-deep);
    background: var(--blue-soft);
  }
  .funnel.after .step-n {
    color: var(--green);
    background: var(--green-soft);
  }
  .step-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .step-head b {
    font: 700 15px/1.3 var(--display);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .bar {
    height: 10px;
    border-radius: 999px;
    background: var(--line-2);
    margin: 7px 0 3px;
    overflow: hidden;
  }
  .bar.thin {
    height: 6px;
    margin: 6px 0 0;
  }
  .bar i {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--blue), #6f8fff);
  }
  .funnel.after .bar i {
    background: linear-gradient(90deg, #0f9d63, #3fcf8e);
  }
  .rate {
    font-size: 12px;
    color: var(--muted);
  }
  .split {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line-2);
  }
  .split span {
    display: inline-flex;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--bg);
    font-size: 13px;
    color: var(--muted);
  }
  .split b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .channel {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .swatch {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .swatch.google_ads {
    background: #f4b400;
  }
  .swatch.meta {
    background: var(--meta);
  }
  .swatch.organico {
    background: var(--green);
  }
  .swatch.directo {
    background: var(--violet);
  }
  .swatch.otros {
    background: var(--faint);
  }
  .note {
    font-size: 12.5px;
    color: var(--muted);
    margin: 14px 0 0;
  }
  .note.foot {
    text-align: center;
    margin-top: 8px;
  }
  .pages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .page-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }
  .path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 13px;
    color: var(--ink-2);
  }
  .page-row > .tnum {
    white-space: nowrap;
  }
  .stack {
    display: flex;
    height: 14px;
    gap: 3px;
    border-radius: 999px;
    overflow: hidden;
    margin: 4px 0 18px;
  }
  .stack .seg {
    width: var(--w);
    height: 100%;
  }
  .seg.s0 {
    background: var(--blue);
  }
  .seg.s1 {
    background: #8aa3ff;
  }
  .seg.s2 {
    background: #c9d5ff;
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .legend li {
    display: grid;
    grid-template-columns: 10px 1fr auto 64px;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }
  .legend .seg {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .legend .muted {
    text-align: right;
  }
  @media (max-width: 1100px) {
    .kpis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kpi strong {
      font-size: 23px;
    }
    .kpi-icon {
      margin-bottom: 6px;
    }
  }
</style>
