---
// Shell of the private portal (/admin): sidebar with the sections, page header and content.
// Same typefaces and blue as the public site; the portal is never indexed.
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/admin.css';

interface Props {
  title: string;
  section: 'contactos' | 'embudo';
  subtitle?: string;
}
const { title, section, subtitle } = Astro.props;

const nav = [
  {
    key: 'contactos',
    href: '/admin',
    label: 'Contactos',
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
  {
    key: 'embudo',
    href: '/admin/embudo',
    label: 'Embudo',
    icon: 'M3 4h18l-7 8.5V19l-4 2v-8.5Z',
  },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4f6fb" />
    <link rel="icon" href="/assets/aisolutionsblue-favicon.ico" />
    <title>{title} · Portal Blue</title>
    <slot name="head" />
  </head>
  <body class="app">
    <aside class="sidebar">
      <a class="brand" href="/admin" aria-label="Portal de Blue">
        <img src="/assets/logo.webp" alt="Blue" width="72" height="34" />
        <span>Portal</span>
      </a>
      <nav class="nav" aria-label="Secciones del portal">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.key === section ? 'page' : undefined}>
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={item.icon} />
            </svg>
            {item.label}
          </a>
        ))}
      </nav>
      <form class="logout" method="post" action="/api/admin/login">
        <input type="hidden" name="action" value="logout" />
        <button type="submit">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
          </svg>
          Salir
        </button>
      </form>
    </aside>
    <main class="content">
      <header class="page-head">
        <div>
          <h1>{title}</h1>
          {subtitle && <p class="page-sub">{subtitle}</p>}
        </div>
        <div class="page-actions">
          <slot name="actions" />
        </div>
      </header>
      <slot />
    </main>
  </body>
</html>
